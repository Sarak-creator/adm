# =======================================================
# អាណាចក្រDiamond (Diamond Kingdom) - Environment Variables
# =======================================================

# PostgreSQL Database Connection Strings (Supabase format)
# Transaction pooler (Port 6543) - used by Prisma Client for app queries
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session / Direct connection (Port 5432) - used by Prisma CLI for migrations & db push
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# MooGold API Credentials (doc.moogold.com)
MOOGOLD_PARTNER_ID="your_partner_id_here"
MOOGOLD_SECRET_KEY="your_secret_key_here"
MOOGOLD_BASE_URL="https://moogold.com/wp-json/v1/api"
MOOGOLD_SANDBOX_MODE="true"

# Bakong KHQR Merchant Configuration
BAKONG_ACCOUNT_ID="your_bakong_id@bank"
BAKONG_MERCHANT_NAME="ANAJAK DIAMOND"
BAKONG_MERCHANT_CITY="Phnom Penh"
BAKONG_WEBHOOK_SECRET="your_webhook_secret_here"

# ABA PayWay Payment Gateway
ABA_PAYWAY_MERCHANT_ID="your_payway_merchant_id"
ABA_PAYWAY_API_KEY="your_payway_api_key"
ABA_PAYWAY_API_URL="https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase"
ABA_PAYWAY_CHECK_URL="https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2"

# Currency Exchange Configuration (1 USD to KHR)
EXCHANGE_RATE_USD_KHR="4100"

# Admin Dashboard Access & Security
ADMIN_SECRET="anajak_admin_2026"
ADMIN_SECRET_PATH="portal-anachak-9821"
ADMIN_2FA_PIN="982100"
ADMIN_ALLOWED_IPS=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
APP_MASTER_ENCRYPTION_KEY="your_64_character_hex_master_encryption_key_here"

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =======================================================
# Cloud Storage for Vercel Image Upload (Optional)
# If left empty, uploads on Vercel will automatically use
# Base64 Data URL fallback (Zero config needed).
# =======================================================
# Option 1: Vercel Blob Storage (Recommended for Vercel: Vercel Dashboard -> Storage -> Create Blob)
BLOB_READ_WRITE_TOKEN=""

# Option 2: Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
